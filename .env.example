# Copy to .env and adjust. Everything is optional – defaults work on localhost with your Claude plan.

# --- Server
# HOST=127.0.0.1
# PORT=8765
# Required when the server is reachable from other devices (phone via Tailscale, LAN):
# ADVISOR_TOKEN=change-me-long-random-string

# --- Claude Code (uses your logged-in `claude` CLI / Claude plan)
# CLAUDE_BIN=claude
# MODEL_QUICK=sonnet          # quick answers (lunch-table questions)
# MODEL_DEEP=opus             # deep mode: subagents + web research
# MODEL_LAW_ANALYSIS=opus     # analysis of law changes
# CLAUDE_TIMEOUT_S=600
# ISOLATE_CLAUDE_CONFIG=true  # ignore your global Claude plugins/MCP servers for the advisor
# CLAUDE_EXTRA_ARGS=          # extra flags passed to every claude call

# --- Law sync (runs inside the server)
# LAW_SYNC_INTERVAL_HOURS=24  # 0 = off
# LAW_SYNC_ANALYZE=true       # AI impact analysis + knowledge updates for detected changes
# LAW_NEWS_INTERVAL_DAYS=7    # AI web watch for news / Finančná správa guidance; 0 = off
# LAW_ANALYSIS_MAX_PER_RUN=5

# --- Voice (optional; default = browser speech recognition + browser voices, no keys)
# STT_PROVIDER=none           # none | openai | local (pip install faster-whisper)
# TTS_PROVIDER=none           # none | openai | elevenlabs
# OPENAI_API_KEY=
# OPENAI_TTS_VOICE=alloy
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# LOCAL_WHISPER_MODEL=small
